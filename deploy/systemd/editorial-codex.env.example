# Copiar para /etc/leiprova/editorial-codex.env (root:root 644). Sem segredos.
# Instância Codex do motor editorial: só Autor, 2 vagas, login próprio em CODEX_HOME.
EDITORIAL_EXECUTOR=codex
# O mesmo nome vai para generatorModel das questões.
EDITORIAL_EXECUTOR_MODEL=gpt-6-luna
EDITORIAL_EXECUTOR_BIN=/usr/local/bin/codex
EDITORIAL_SLOTS_GUARDIAO=0
EDITORIAL_SLOTS_AUTOR=2
EDITORIAL_TASK_TIMEOUT_MIN=25
EDITORIAL_IDLE_SECONDS=60
EDITORIAL_LIMIT_COOLDOWN_MIN=30
# Login da assinatura feito pelo proprietário com este CODEX_HOME (ver docs/MOTOR-CODEX-PARALELO.md).
CODEX_HOME=/var/lib/leiprova-codex/codex-home
# Dispara a mesma linha de liberação da instância principal (o .path observa este arquivo).
EDITORIAL_RELEASE_TRIGGER_FILE=/var/lib/leiprova-realtime/release.trigger
# Trava compartilhada da ponte: a instância principal precisa da MESMA linha no editorial-realtime.env.
EDITORIAL_BRIDGE_LOCK_FILE=/var/lib/leiprova-realtime/bridge.lock
# Mesma ordem de foco da instância principal (copiar de /etc/leiprova/editorial-realtime.env).
# EDITORIAL_FOCUS_PRODUCTS=
