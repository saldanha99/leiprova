# Copiar para /etc/leiprova/editorial-realtime.env (root:root 644). Sem segredos.
# claude (Claude Code) ou codex (Codex CLI); ambos usam o login da assinatura.
EDITORIAL_EXECUTOR=claude
# Vazio = modelo padrão da CLI. O mesmo nome vai para generatorModel.
EDITORIAL_EXECUTOR_MODEL=
# Caminho absoluto da CLI se não estiver no PATH do serviço.
# EDITORIAL_EXECUTOR_BIN=/usr/local/bin/claude
EDITORIAL_SLOTS_GUARDIAO=1
EDITORIAL_SLOTS_AUTOR=2
EDITORIAL_TASK_TIMEOUT_MIN=25
EDITORIAL_IDLE_SECONDS=60
EDITORIAL_LIMIT_COOLDOWN_MIN=30
