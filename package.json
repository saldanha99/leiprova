{
  "name": "leiprova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "content:verify": "tsx scripts/verify-content.ts",
    "legal:sources:check": "tsx --env-file-if-exists=.env scripts/check-official-sources.ts",
    "opportunities:sources:check": "tsx --env-file-if-exists=.env scripts/check-open-opportunities.ts",
    "opportunities:approve": "tsx --env-file-if-exists=.env scripts/approve-official-opportunities.ts",
    "editorial:automation": "tsx --env-file-if-exists=.env scripts/run-editorial-automation.ts",
    "editorial:local:verify": "tsx --env-file-if-exists=.env scripts/validate-local-authoring.ts",
    "editorial:local:import": "tsx --env-file-if-exists=.env scripts/import-local-editorial-drafts.ts",
    "editorial:operate": "tsx --env-file-if-exists=.env scripts/operate-editorial-package.ts",
    "editorial:drafts:import": "tsx --env-file-if-exists=.env scripts/import-editorial-draft-package.ts",
    "editorial:review:80": "tsx --env-file-if-exists=.env scripts/review-editorial-80.ts",
    "editorial:bindings:import": "tsx --env-file-if-exists=.env scripts/import-product-question-bindings.ts",
    "editorial:courses:plan": "tsx --env-file-if-exists=.env scripts/plan-course-production.ts",
    "editorial:scoped:verify": "tsx --env-file-if-exists=.env scripts/validate-scoped-authoring.ts",
    "stripe:inventory": "tsx --env-file-if-exists=.env scripts/inventory-stripe-catalog.ts",
    "stripe:catalog": "tsx --env-file-if-exists=.env scripts/sync-contest-stripe.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "cheerio": "1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.19.0"
}
