# Aplicação
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_COOKIE_NAME=leiprova_session
AUTH_SESSION_DAYS=30
ADMIN_EMAILS=
REGISTRATION_ENABLED=false
CONTACT_ENABLED=false

# E-mail transacional — mantenha false até cadastrar o domínio de envio,
# validar SPF/DKIM/DMARC e guardar o token somente no .env da VPS.
TRANSACTIONAL_EMAIL_ENABLED=false
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=

# PostgreSQL (em produção, a aplicação conecta pelo pooler)
DATABASE_URL=postgresql://leiprova:change-me@localhost:6432/leiprova
MIGRATION_DATABASE_URL=postgresql://leiprova_owner:change-me@localhost:5432/leiprova

# Identificação do fornecedor — Decreto 7.962/2013, art. 2º, I, e LGPD, art. 41.
# Enquanto QUALQUER um destes estiver vazio, getCheckoutAvailability devolve
# reason "supplier_identity" e o checkout não abre. Fica no .env, e não no
# código, porque o repositório é público e endereço com CNPJ não se versiona.
SUPPLIER_LEGAL_NAME=
SUPPLIER_TRADE_NAME=
SUPPLIER_TAX_ID=
SUPPLIER_ADDRESS=
SUPPLIER_EMAIL=
SUPPLIER_SUPPORT_CHANNEL=
SUPPLIER_DPO_CONTACT=

# Stripe — nunca coloque rk_/sk_ em NEXT_PUBLIC_*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_RITMO=
STRIPE_PRICE_FOCO=
STRIPE_PORTAL_CONFIGURATION_ID=
CHECKOUT_ENABLED=false

# Stripe Connect — sempre false até aprovação da Stripe e validação jurídica/contábil
STRIPE_CONNECT_ENABLED=false
# Pode ser ligado somente em test para gerar o formulário Express, sem liberar repasses.
STRIPE_CONNECT_ONBOARDING_ENABLED=false
STRIPE_CONNECT_BR_APPROVED=false
STRIPE_CONNECT_MODE=test
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_COUNTRY=BR
STRIPE_CONNECT_CURRENCY=brl
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/admin/stripe-connect?onboarding=retorno
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/admin/stripe-connect?onboarding=renovar

# Hash opcional para anonimizar IPs de sessão
IP_HASH_SECRET=change-me-with-at-least-32-random-characters
